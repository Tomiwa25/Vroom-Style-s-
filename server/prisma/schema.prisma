generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  firstName  String
  lastName   String
  role       Role      @default(CUSTOMER)
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cart      Cart?
  orders    Order[]

  @@map("users")
}

enum Role {
    CUSTOMER
    ADMIN
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, type])
  @@map("otp_verifications")
}

model Product {
  id          String   @id @default(uuid())
  externalId  Int?     @unique
  sku         String?
  name        String
  slug        String?
  description String
  price       Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)
  image       String 
  images      String[] @default([])
  category    String
  subcategory String?
  brand       String?
  stock       Int
  tag         String?
  sizes       String[] @default([])
  colors      Json?
  material    String?
  fitGuide    String?
  specs       Json?
  dimensions  Json?
  weight      Float?
  sellerType  String?  @default("1P") // 1P = Vroom Direct, 3P = Marketplace Partner
  sellerName  String?
  sellerRating Int?
  isFulfilledByVroom Boolean? @default(true)
  warranty    String?
  bundledIncentive String?
  isPodEligible Boolean? @default(true)
  podTerms    String?
  rating      Float?
  reviewCount Int?
  isDemo      Boolean  @default(false)
  jobId       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 
  
  generationJob ProductGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([sku])
  @@index([category])
  @@index([isDemo])
  @@index([jobId])
  @@index([isActive, createdAt])
  @@map("products")
}

model ProductGenerationJob {
  id                String    @id @default(uuid())
  status            String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  totalRequested    Int
  totalGenerated    Int       @default(0)
  totalFailed       Int       @default(0)
  categories        String[]  @default([])
  seed              Int?
  includeVariations Boolean   @default(true)
  errorDetails      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  products          Product[]

  @@map("product_generation_jobs")
}

model Cart {
    id          String   @id @default(uuid())
    userId      String   @unique
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    items       CartItem[]

    @@map("carts")
}

model CartItem {
    id          String   @id @default(uuid())
    cartId      String   
    productId   String
    quantity    Int


    cart        Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
    product     Product    @relation(fields: [productId], references: [id])
    
    @@unique([cartId, productId])
    @@map("cart_items")
}


enum DeliveryMethod {
    PAYSTACK
    POD
}

model Order {
    id          String          @id @default(uuid())
    userId      String
    total       Decimal         @db.Decimal(12, 2)
    status      OrderStatus     @default(PENDING)
    paymentStatus PaymentStatus @default(PENDING)
    deliveryMethod DeliveryMethod @default(PAYSTACK)

    // Shipping details, only used for POD orders for now. Kept loose so
    // Paystack orders gain them later without another migration.
    shippingName      String?
    shippingPhone     String?
    shippingAddress   String?
    shippingCity      String?
    shippingNotes     String?

    // Set the first time stock was returned to inventory (order expiry,
    // admin cancellation, failed payment). Guards against double restock.
    stockReleasedAt DateTime?

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    user        User            @relation(fields: [userId], references: [id])
    items       OrderItem[]
    payment     Payment?

    @@index([status, paymentStatus, createdAt])
    @@index([userId])
    @@map("orders")

}

enum OrderStatus {
    PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String   @unique
  reference String?  @unique
  amount    Decimal  @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime    @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum IdempotencyStatus {
  PROCESSING
  RESOLVED
  FAILED
}

model IdempotencyKey {
  id           String            @id @default(uuid())
  key          String            @unique
  userId       String?
  path         String
  method       String
  requestHash  String
  status       IdempotencyStatus @default(PROCESSING)
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  expiresAt    DateTime

  @@index([key, userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
