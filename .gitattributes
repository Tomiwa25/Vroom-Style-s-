# Normalise line endings: repo stores LF, checked out as LF on every platform
* text=auto eol=lf

# Windows-native scripts keep CRLF so cmd.exe can run them
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets – never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
